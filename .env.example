# ═══════════════════════════════════════════════════════════════════════════════
#                     APEX GUARD — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# ─── REQUIRED ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
OWNER_IDS=123456789012345678,987654321098765432

# ─── OPTIONAL ──────────────────────────────────────────────────────────────────
BOT_PREFIX=!
LOG_LEVEL=INFO

# Security channels
LOG_CHANNEL_ID=0
ERROR_CHANNEL_ID=0

# Verification
VERIF_ROLE_ID=0
VERIF_CHANNEL_ID=0
CAPTCHA_TIMEOUT=300

# Anti-Raid / Anti-Spam
RAID_WINDOW=10
RAID_THRESHOLD=10
SPAM_THRESHOLD=5
SPAM_WINDOW=5
SPAM_MUTE=300

# ─── EXTERNAL APIs (OPTIONAL) ──────────────────────────────────────────────────
VIRUSTOTAL_API=
IPQUALITY_API=
